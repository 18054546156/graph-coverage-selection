+# >>> TD-COVER RUNTIME HOOK (2026-09-25) -- added outside graphcov/ on purpose.
+# Registers one extra selector into the in-memory METHODS registry. No file
+# under graphcov/ is modified, so assert_graphcov_source_unchanged() still
+# passes and every published method behaves exactly as before.
+#
+# The TD-Cover arms compute their picks offline (gamma_beta_gate/td_cover.py)
+# and stage them as .npy. This loader replays them, so the graph_a2 baseline and
+# every TD-Cover arm reach the trainer through an identical code path and cannot
+# differ by harness rather than by which images were chosen.
+def _register_precomputed_selector():
+    import os as _os
+    import numpy as _np
+
+    @graphcov_selection.register_method(
+        'precomputed', needs=set(), importance='ignore',
+        description="Load selection indices from $TD_SEL_FILE (.npy)")
+    # importance defaults to None: select() omits the argument entirely for
+    # methods registered with importance='ignore', so it must not be positional.
+    def _select_precomputed(labels, budget_per_class, importance=None,
+                            seed=42, verbose=False, _verbose_level=1, **kwargs):
+        path = _os.environ.get("TD_SEL_FILE", "")
+        if not path or not _os.path.exists(path):
+            raise FileNotFoundError(f"TD_SEL_FILE not set or missing: {path!r}")
+        idx = _np.load(path).astype(int).ravel().tolist()
+
+        # Fail loudly rather than silently train a different budget: a mismatch
+        # would confound the arm comparison with a budget change, which is the
+        # one thing this screen holds fixed.
+        n_classes = len(_np.unique(labels))
+        expected = budget_per_class * n_classes
+        if len(idx) != expected:
+            raise ValueError(f"{path}: {len(idx)} indices, expected {expected} "
+                             f"({budget_per_class}/class x {n_classes} classes)")
+        if len(set(idx)) != len(idx):
+            raise ValueError(f"{path}: duplicate indices")
+        counts = _np.bincount(_np.asarray(labels)[idx], minlength=n_classes)
+        if not _np.all(counts == budget_per_class):
+            raise ValueError(f"{path}: per-class counts {counts.tolist()} != "
+                             f"{budget_per_class} each")
+        print(f"  [precomputed] loaded {len(idx)} indices from {path}", flush=True)
+        return idx
+
+
+_register_precomputed_selector()
