{
  "schema": "graphcov-table1/job2-config-v1",
  "purpose": "Frozen-index downstream Table 1 evaluation",
  "selection_root": "{project_root}/table1_reproduction/outputs/job1_selection_clean",
  "output_root": "{project_root}/table1_reproduction/outputs/job2_table1_valckpt",
  "validation_split": "val",
  "evaluation_split": "test",
  "datasets": [
    "organsmnist",
    "organamnist",
    "pathmnist",
    "tissuemnist",
    "bloodmnist"
  ],
  "ratios": [0.02, 0.05],
  "methods": [
    "random",
    "el2n",
    "forgetting",
    "eva",
    "facility",
    "fps",
    "herding",
    "graph_a2"
  ],
  "training_seeds": [42, 43, 44, 45, 46],
  "fixed_selection_seed": 42,
  "selection_seed_policy": {
    "random": "training_seed",
    "fps": "training_seed",
    "default": "fixed"
  },
  "training": {
    "size": 224,
    "epochs": 1000,
    "batch_size": 256,
    "learning_rate": 0.1,
    "momentum": 0.9,
    "nesterov": false,
    "weight_decay": 0.0005,
    "augmentation": false,
    "evaluate_every": 10,
    "num_workers": 4,
    "deterministic": false
  },
  "assumptions": [
    "Job 2 only consumes Job 1 selected indices; it never regenerates a subset.",
    "The paper reports balanced accuracy; accuracy, worst-class recall and CVaR20 are retained as audit metrics.",
    "Training reads validation only and saves the best validation checkpoint; test is loaded after training and evaluated exactly once.",
    "The old job2_table1 output is retained as a historical run and is not mixed with this strict validation-checkpoint output."
  ]
}
