+            "    reproduction = table.apply(lambda r: f\"{r.reproduction_mean_pct:.2f}+/-{r.reproduction_std_pct:.2f}\", axis=1),\n"
+            "    paper = table.apply(lambda r: f\"{r.paper_mean_pct:.1f}+/-{r.paper_std_pct:.1f}\", axis=1),\n"
